    },
    "The contact is deleted from Contacts now. cardXchange keeps a copy without the note, and the person's events, notes, tags and photos, for 30 days under Recently Deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontakt wird jetzt aus Kontakte gelöscht. cardXchange behält eine Kopie ohne Notiz sowie Ereignisse, Notizen, Tags und Fotos der Person 30 Tage lang unter „Zuletzt gelöscht“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact est supprimé de Contacts maintenant. cardXchange garde une copie sans la note, ainsi que les événements, notes, tags et photos de la personne, pendant 30 jours dans « Suppressions récentes »."
          }
        }
      }
    },
    "The contact of %@ is not on this device. Delete the person on the device that has the contact.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontakt von %@ ist nicht auf diesem Gerät. Lösche die Person auf dem Gerät, das den Kontakt hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact de %@ n’est pas sur cet appareil. Supprimez la personne sur l’appareil qui a le contact."
          }
