          }
        }
      }
    },
    "cardXchange has no access to Contacts. Allow it in System Settings → Privacy & Security → Contacts, or pass --no-contacts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange hat keinen Zugriff auf Kontakte. Erlaube ihn in Systemeinstellungen → Datenschutz & Sicherheit → Kontakte oder gib --no-contacts an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange n’a pas accès à Contacts. Autorisez-le dans Réglages Système → Confidentialité et sécurité → Contacts, ou passez --no-contacts."
          }
        }
      }
    },
    "cardXchange has no access to your calendar. Allow it in Settings → Privacy & Security → Calendars.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange hat keinen Zugriff auf deinen Kalender. Erlaube ihn in Einstellungen → Datenschutz & Sicherheit → Kalender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange n’a pas accès à votre calendrier. Autorisez-le dans Réglages → Confidentialité et sécurité → Calendriers."
          }
        }
      }
    },
    "cardXchange is not using Contacts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange verwendet Kontakte nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange n’utilise pas Contacts."
          }
        }
      }
    },
    "cardXchange keeps a deleted person for 30 days, with their events, notes, tags and photos. Then it deletes them for good. A restored contact has no note.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange behält eine gelöschte Person 30 Tage lang mit ihren Ereignissen, Notizen, Tags und Fotos. Danach löscht es sie endgültig. Ein wiederhergestellter Kontakt hat keine Notiz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange garde une personne supprimée pendant 30 jours, avec ses événements, notes, tags et photos. Puis il la supprime définitivement. Un contact récupéré n’a pas de note."
          }
        }
      }
    },
    "cardXchange keeps the person's events, notes, tags and photos for 30 days under Recently Deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange behält Ereignisse, Notizen, Tags und Fotos der Person 30 Tage lang unter „Zuletzt gelöscht“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cardXchange garde les événements, notes, tags et photos de la personne pendant 30 jours dans « Suppressions récentes »."
          }
        }
      }
    },
